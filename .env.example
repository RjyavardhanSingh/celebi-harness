# Celebi Environment Variables
# Copy this file to .env and fill in your API keys.
#
# Required: At least one provider API key.

# Gemini (Google AI)
GEMINI_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Optional: Override default model
CELEBI_MODEL=gemini-3.5-flash-lite
CELEBI_LITELLM_MODEL=gemini/gemini-3.5-flash-lite
CELEBI_ENV_KEY=GEMINI_KEY

# Optional: Override ports
PROXY_PORT=8000
LITELLM_PORT=4000
